name: CI

on:
  push:
    branches: ["main"]
  pull_request:

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: extractions/setup-just@v3
{%- if ci_needs_github_token | default(false) %}
        with:
          github-token: ${{ '{{' }} secrets.GH_PAT {{ '}}' }}
{%- endif %}
{% if python != 'none' %}
      - uses: astral-sh/setup-uv@v5
        with:
          version: "latest"
          python-version: "{{ python_version }}"
{%- if ci_needs_github_token | default(false) %}
          github-token: ${{ '{{' }} secrets.GH_PAT {{ '}}' }}
{%- endif %}

      - name: Install dependencies
        run: {% if python == 'component' %}cd {{ component_dir }} && {% endif %}uv sync --frozen

{% elif hooks != 'none' %}
      - name: Install pre-commit
        run: pip install pre-commit

{% endif %}
      - name: Check
        run: just check
{% if is_service %}
  docker-build:
    needs: quality
    runs-on: ubuntu-latest
{%- if not gha_cache | default(false) %}
    # Read-only: pull_request runs don't get packages: write (only runs on main
    # do), and this job only reads the registry-backed build cache that CD
    # populates. The Forgejo runner cannot reach the Actions cache that type=gha
    # needs, so the registry is the cache backend.
    permissions:
      contents: read
      packages: read
{%- endif %}
    steps:
      - uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
{%- if not gha_cache | default(false) %}

      # Required to read the registry-backed build cache below.
      - name: Log in to container registry
        uses: docker/login-action@v3
        with:
          registry: {{ registry }}
          username: ${{ '{{' }} github.actor {{ '}}' }}
          password: ${{ '{{' }} secrets.GITHUB_TOKEN {{ '}}' }}
{%- endif %}

      - name: Build
        uses: docker/build-push-action@v6
        with:
          context: .
          push: false
{%- if gha_cache | default(false) %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
{%- else %}
          # type=gha is unreachable on the Forgejo runner; read the registry
          # cache that CD populates. No cache-to: pull_request runs lack
          # packages: write.
          cache-from: type=registry,ref={{ registry }}/${{ '{{' }} github.repository {{ '}}' }}:buildcache
{%- endif %}
{%- endif %}
